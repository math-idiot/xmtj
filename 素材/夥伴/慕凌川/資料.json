g","立繪":"3000082.png","傳記":[{"章名":"走馬上任","摘要":"慕凌川留在京城接管護都軍。面對底下那群富貴少爺兵們散漫敷衍的態度與私下的非議，他從容不迫，決定徐徐圖之。","解鎖好感度":300,"劇情編號":20051,"對白句數":17},{"章名":"茶樓立威","摘要":"京中少爺在茶樓鬥毆，護都軍推諉。慕凌川親自前往，精準拿捏世家痛處，且以強硬武力教訓鬧事者，初樹威信。","解鎖好感度":500,"劇情編號":20052,"對白句數":47},{"章名":"徒手擋災","摘要":"兩紈絝臨走時泄憤導致鐵架倒塌。慕凌川徒手擋下護住夥計，強硬下令將二人捆回府去。悍將作風徹底震懾了手下士兵。","解鎖好感度":650,"劇情編號":20053,"對白句數":26},{"章名":"軍營探傷","摘要":"心醫被急召入營為慕凌川治傷。慕凌川吐露自己假裝莽夫的考量，並趁機向她“推銷”自己。","解鎖好感度":800,"劇情編號":20054,"對白句數":40},{"章名":"火場救援","摘要":"西市煙花鋪突發爆炸引發大火。慕凌川衝入火場，與同在救人的心醫合力救出女童。事後，他敏銳發現現場有火藥殘留。","解鎖好感度":1000,"劇情編號":20055,"對白句數":42},{"章名":"廢墟訓軍","摘要":"面對慘烈的死傷及悲痛的百姓，慕凌川藉機嚴厲訓斥平日散漫度日的護都軍，令士兵們深感失職之愧並生出畏懼之心。","解鎖好感度":1350,"劇情編號":20056,"對白句數":17},{"章名":"暗夜尋蹤","摘要":"慕凌川夜探廢墟遇神祕黑影，心醫提燈同至。兩人察驗出具有致幻效用的毒粉並發現鬼面蘚，據此線索前往暗溝追查。","解鎖好感度":1650,"劇情編號":20057,"對白句數":24},{"章名":"暗溝激戰","摘要":"兩人追蹤至暗溝發現遇害匠人，與蒙面兇手激戰。兇手不敵撞槍自盡。兩人隨之從牆後搜出指向“歸墟”的帳冊與火藥密道。","解鎖好感度":2050,"劇情編號":20058,"對白句數":34},{"章名":"血鎮狼毒","摘要":"慕凌川因毒粉誘發狼毒。心醫趕赴營帳，以自身鮮血助他壓制狂化。清醒後的他滿心愧疚，深情剖白。","解鎖好感度":2500,"劇情編號":20059,"對白句數":48},{"章名":"懲過誓師","摘要":"朝堂追責爆炸案，慕凌川領受責罰，內心愈發堅定護民之志。他誓要使護都軍成為真正的護都之師。","解鎖好感度":3000,"劇情編號":20060,"對白句數":45}],"傳記章數":10,"推薦搭配":[{"組合名":"月下戎魂","屬性碼":1,"屬性":null,"推薦寵物":[{"名稱":"仙鹿","編號":9005}],"推薦珍寶":{"名稱":"虛月誓約","編號":16001},"達成獎勵":"行動力×50","達成獎勵碼":"2_3000_50","產出":[{"類型":"道具","編號":3000,"名稱":"行動力","數量":"50"}],"品質":4}],"全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"},{"狀態":"待機-擔憂","動作代號":"idle_danyou"},{"狀態":"待機-擔憂-說話","動作代號":"idle_danyou_talk"},{"狀態":"待機-驚訝","動作代號":"idle_jingya"},{"狀態":"待機-驚訝-說話","動作代號":"idle_jingya_talk"},{"狀態":"待機-開心","動作代號":"idle_kaixin"},{"狀態":"待機-開心-說話","動作代號":"idle_kaixin_talk"},{"狀態":"待機-哭泣","動作代號":"idle_kuqi"},{"狀態":"待機-哭泣-說話","動作代號":"idle_kuqi_talk"},{"狀態":"待機-生氣","動作代號":"idle_shengqi"},{"狀態":"待機-生氣-說話","動作代號":"idle_shengqi_talk"},{"狀態":"待機-思考","動作代號":"idle_sikao"},{"狀態":"待機-思考-說話","動作代號":"idle_sikao_talk"},{"狀態":"待機-說話","動作代號":"idle_talk"},{"狀態":"待機-無手持","動作代號":"idle_wushouchi"},{"狀態":"待機-無手持-說話","動作代號":"idle_wushouchi_talk"},{"狀態"