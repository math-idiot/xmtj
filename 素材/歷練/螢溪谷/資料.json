"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106002_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9603,"名稱":"碎片3","說明":"《林連清手札殘頁》：師父收我為徒時，送了我一把藥鏟。他說這鏟子跟了他二十年，挖過的藥材比我見過的還多。我接過，沉甸甸的。後來我才知道，這把鏟子是師祖傳給他的。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106003_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9604,"名稱":"碎片4","說明":"《林連清手札殘頁》：那年我受了重傷，躺在牀上動不了。師父每天來給我換藥，我說師父等你老了，我也會這樣伺候你。他笑笑，沒有說話。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106004_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9605,"名稱":"碎片5","說明":"《林連清手札殘頁》：師父帶我去集市。有個賣菜的老漢認出他，非要送他菜，說報答他的恩情。師父推辭不過，收下了，然後轉頭把錢給別人，請他幫忙包了老漢攤子上的其他菜。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106005_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9606,"名稱":"碎片6","說明":"《林連清手札殘頁》：今日給師父擦身，他突然抓住我的手，喊了一個名字。我愣了很久。後來才知道，那是他故友的名字。原來人在最糊塗的時候，記得的總是最刻骨的事。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106006_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9607,"名稱":"碎片7","說明":"《林連清手札殘頁》：師父夜裏又發狂了。他把藥碗摔在地上，碎片濺到我腳上，我沒躲。他罵我，罵得很難聽，說我要害他，可我知道這不是他……","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106007_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9608,"名稱":"碎片8","說明":"《林連清手札殘頁》：師父半夜忽然坐起來，唱了一首歌，唱完又躺下，繼續睡。第二天我問他，昨晚唱歌了記得嗎？他搖頭。我去查那首歌的來歷，是這一帶的民謠，唱的是一人等另一人。他在等誰呢？","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106008_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9609,"名稱":"碎片9","說明":"《林連清手札殘頁》：師父今天坐起來，要自己吃飯。我把勺子遞給他，他手抖得厲害，粥灑了出來。他生氣，把勺子扔了。師父……什麼時候能恢復正常呢？或許，我等不到那一天了……","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106009_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9610,"名稱":"碎片10","說明":"《林連清手札殘頁》：今日熬了菌子湯，盛了一碗放在師父桌前。放著放著，想起他喝不到了。我把那碗湯端起來自己喝了，味道不對。可到底是哪裡不對呢？","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106010_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9611,"名稱":"碎片11","說明":"《谷居瑣記》：三更醒，聞雨聲。忽憶白日裏小徒弟煎藥，火候過了三分。我罰他重煎，他一邊哭一邊守在藥爐邊，看著挺委屈的。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106011_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9612,"名稱":"碎片12","說明":"《谷居瑣記》：小徒弟問我，師父，學醫苦不苦。我說苦。又問，那為什麼還要學。我說，因為有人比我們更苦。他不說話了，低頭繼續背藥方。那日他背到子時，我也陪著他到了子時。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106012_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9613,"名稱":"碎片13","說明":"《谷居瑣記》：採藥途中遇一老者，癱坐路邊，面黃肌瘦。診之，非病，餓也。取乾糧予之，又煎一碗補藥。老者問我是誰，我說大夫。他拜了三拜，顫巍巍走了。此事平常，不值得記。但還是記了。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106013_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9614,"名稱":"碎片14","說明":"《谷居瑣記》：灶房今日燉了菌子湯。弟子們搶著喝，我喝了一碗，味道鮮美。小徒弟問我喜歡喝嗎？喜歡的話，他往後做給我喝。是個好孩子啊……與年輕時的他有幾分相像。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106014_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9615,"名稱":"碎片15","說明":"《谷居瑣記》：昨夜夢見少年時，師父還在，罵我背不出《傷寒論》，醒來枕邊溼。窗外雨未停，我披衣坐起，把那本翻爛的《傷寒論》又翻了一遍。能背了，可師父不在了。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106015_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9616,"名稱":"碎片16","說明":"《谷居瑣記》：螢溪谷的藥材從不愁賣，愁的是怎麼運出去。山路崎嶇，騾馬難行，弟子們便訓練了一批猴子幫忙馱藥。久而久之，這批猴子比弟子們還熟悉谷中每一條岔路。有弟子不服，和猴子比認路，結果在山裏轉了三天才被找回來。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106016_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9617,"名稱":"碎片17","說明":"《谷居瑣記》：螢溪谷的鍼灸課是兩人一組互相練習。每到結業考核那天，谷中就會出現一群渾身插滿銀針的，像刺蝟一樣的弟子。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106017_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9618,"名稱":"碎片18","說明":"《谷居瑣記》：驚蟄。去後山採了半簍當歸。這藥名起得真好，當歸，當歸。可世間多少來看病的人，等不到病好，就再也回不去了。小徒弟說，只要醫術好，就沒有治不好的病，我說他實在太天真了。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106018_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9619,"名稱":"碎片19","說明":"《谷居瑣記》：谷裏接連下了七天暴雨。夜裏熬藥時，我無數次想起未能救下的故友。我救了很多人，但最想救的人……沒能救下。小徒弟問我，這麼出神在想什麼，我看著他，沒有說話。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106019_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":9620,"名稱":"碎片20","說明":"《谷居瑣記》：診了個患“相思病”的姑娘。脈象鬱結，心氣耗損，眼看是不行了。我給她開了些安神的方子，但我沒告訴她，相思無藥可醫。不過，若這世上真的有傳說中的心醫，或許能救她。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"螢溪谷/103106020_螢溪舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]}]},"事件數":57,"引用":{"類":"歷練","名":"螢溪谷","名稱":"螢溪谷","編號":206}}