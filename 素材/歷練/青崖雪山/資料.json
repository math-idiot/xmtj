冰牀"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}],"事件":{"類":"歷練","名":"青崖雪山/57150005_冰牀"},"圖":"青崖雪山/圖鑑/4505.png"}],"舊聞":[{"編號":4601,"名稱":"碎片1","說明":"天闊說，等開春就在鏡湖邊闢一塊花圃，我已經開始期待了。今日去鏡湖邊散步的時候，在湖邊看見個渾身是血的人。天闊本不願惹麻煩，但我看那人求生的眼神實在可憐，便救下了。","探索度":3,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101001_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4602,"名稱":"碎片2","說明":"那人醒了，總是縮在牆角發抖。天闊說看那人手上有繭，怕不是善類，想給點銀子打發走。我勸住了他，這冰天雪地的趕人走，無異於殺人。等雪停了再做打算吧。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101002_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4603,"名稱":"碎片3","說明":"那個被救回來的男人，眼神真嚇人。昨天我去送飯，不小心碰倒了椅子，他蹭地一下就跳起來，手直接往腰後摸，像是在找刀。莊主和夫人太心善了，這種帶煞氣的人留在山莊裏，遲早要出亂子，我總覺得後背發涼。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101003_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4604,"名稱":"碎片4","說明":"那逃犯養傷時總在院子裏轉悠，盯著庫房方向看。有天我送飯，聽見他低聲唸叨：“如果我也有……就好了……”那眼神讓我發毛。我去稟告夫人，她卻笑我多想。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101004_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4605,"名稱":"碎片5","說明":"他們對我太好了，好得不正常。給吃給喝，還不問我來路？世上哪有這種好事。今天我看見那男主子跟個穿官差衣服的人在山下說話，還指了指山莊。呵，原來是把老子當肥羊賣了。我不能坐以待斃，我不能回那個死牢！","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101005_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4606,"名稱":"碎片6","說明":"既然被發現了，就只能滅口。對不住了，若是從前，我也想報恩。可我那剛滿月的閨女還在老家等著我寄錢活命。為了讓她活，別說是兩個恩人，就是全天下的人擋路，我也得殺。要怪，就怪這世道逼人成鬼吧。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101006_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4607,"名稱":"碎片7","說明":"那時山莊還沒這樣冷。阿蘅總愛在檐下聽雪，她說雪花落下的聲音像碎玉。我常陪她整日，我彈琴，她起舞，我們盼著來年春天的到來，要一起種一片花圃。那是我一生最快活的時光。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101007_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4608,"名稱":"碎片8","說明":"今日下山碰到個官差，說在緝拿一名逃犯。我看畫像，很像阿蘅救回來的人……事已至此，不能讓他們發現，給山莊惹來麻煩。我打發走了官差，得想辦法趕緊讓那人離開……","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101008_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4609,"名稱":"碎片9","說明":"我回來時，雪地上都是血。阿蘅躺在那裡，手裏還攥著我送她的簪子。她身子已經冷了，只有髮簪上留著一點溫度。從那天起，這山莊的雪……再也沒停過。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101009_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4610,"名稱":"碎片10","說明":"莊主突然要學冰雕。他雕了三天三夜，雕出夫人的模樣。可怪的是……他不雕眼睛。他說：“雕上眼睛，她就會看見我現在這樣子。”莊主的眼神……讓人害怕，像換了個人。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101010_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4611,"名稱":"碎片11","說明":"莊主開始頻繁下山，每次都帶回些古怪東西。有一次我偷看到，他對著個琉璃罐說話，罐子裏有東西在蠕動。他喃喃道：“再等等……很快你就能回來了。”那天起，我再也不敢獨自進主院。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101011_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4612,"名稱":"碎片12","說明":"那個逃犯被莊主抓住了。莊主沒殺他，反而好酒好肉逼他吃下去，只是每隔幾日就要放一大碗血。那逃犯起初還求饒，後來連叫喚的力氣都沒了。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101012_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4613,"名稱":"碎片13","說明":"阿蘅，我要留住你最美的樣子，我會讓你永遠鮮妍美麗；你若是走不動，我便尋來牽絲蠱助你起舞。上天既然不公，奪我摯愛，我便逆天而行。只要你在我身邊，是人是鬼又何妨？誰敢說你死了，我就讓他真的去死。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101013_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4614,"名稱":"碎片14","說明":"那位護法說得對。為何官府看管不利，讓那惡徒逃脫？為何我們積德行善，蒼天卻不開眼？護法說，這大楚的江山早就爛透了，律法護不住善人。既然天道不公，那我就自己造一個公道。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101014_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4615,"名稱":"碎片15","說明":"護法的法子起效了！阿蘅真的動了！護法告訴我，想要維持這份神蹟，就要用那些十惡不赦之徒的血來餵養。沒錯……朝廷殺不了的人，我來殺；官府判不了的罪，我來判！用他們的髒血換阿蘅的命，這才是世間最大的正義！","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101015_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4616,"名稱":"碎片16","說明":"……楊天闊已入彀中，因為仇恨，現在的他比任何信徒都要虔誠。繼續利用他，讓他為聖教做事，一切為了聖女。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101016_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4617,"名稱":"碎片17","說明":"吾乃“斷水客”獨孤寒。聽聞此山極寒，這是修煉“霜天劍意”的絕佳之地。為登武道之巔，今日我自斷退路，立誓不悟出絕學，決不下山！家中妻兒勿念，待我神功大成，定讓獨孤家名震江湖。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101017_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4618,"名稱":"碎片18","說明":"劍氣已成，昨日斬殺野獸，血噴灑而出，尚未落地便已凝結成冰花。快哉！但我竟有些記不清家人的模樣了……無妨，心中若有掛礙，劍便會慢。忘情，方能至聖。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101018_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4619,"名稱":"碎片19","說明":"神功大成了，可我為何並不歡喜？這裡太靜了，靜得我想發瘋。今日我在鏡湖邊練劍，水中倒影裏是個白髮蒼蒼的老怪物。我遇見了一個男人，他花錢讓我去抓些人回來，說要試試我的武功，哈我怎麼能讓他小瞧了去！","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101019_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":4620,"名稱":"碎片20","說明":"聽雪山莊的莊主出千金邀我上山，只為求一副“美人春睡圖”。作畫之日，終於見到了畫中人，那是一位沉睡在冰牀上的女子。莊主讓我畫她，一遍遍的畫，總覺得不滿意……我想……我可能下不了山了。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"青崖雪山/103101020_青崖舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]}]},"事件數":58,"引用":{"類":"歷練","名":"青崖雪山","名稱":"青崖雪山","編號":201}}