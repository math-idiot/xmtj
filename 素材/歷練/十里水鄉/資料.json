"},"圖":"十里水鄉/圖鑑/6505.png"}],"舊聞":[{"編號":6601,"名稱":"碎片1","說明":"水鄉的鴨子可是“成精”的！有一群當地大白鴨專堵外地客商的路。你不往水裏扔點碎點心，它們就排成一隊堵著河道不讓過，惹得船伕天天站在船頭和一群鴨子對罵。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103001_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6602,"名稱":"碎片2","說明":"據說丐幫以前在水鄉設過一個堂口。那幫叫花子討飯都不走尋常路，踩著破木板滿河道轉。他們手裏那根油光水滑的長竿，上岸能當打狗棒對付惡犬，下水就是撐船的竹篙，一物兩用，絕了！","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103002_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6603,"名稱":"碎片3","說明":"水鄉什麼最多？橋和青苔！頭回來的外地人走一步滑三步。可本地那些端著滾燙熱湯的小二，卻能在蘚綠的長石板上健步如飛，一滴湯不灑，不知道的還以為個個會輕功！","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103003_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6604,"名稱":"碎片4","說明":"早年鄉里窮，大家拿洗澡木盆當船下河採菱，若是遇上急流，都暈得直吐。誰能想到呢，這遭罪的玩意現在成了景緻。專騙外地少爺交錢體驗“特色水鄉木盆”，岸上看熱鬧的大夥天天樂得合不攏嘴。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103004_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6605,"名稱":"碎片5","說明":"沿河捱得近的住戶有個絕活。兩岸人家若是要借個醬醋，全靠一根長竹竿挑著籃子隔著河面遞過去。有回一家遞燒鵝給對岸的親家，半道上竹竿一滑，燒鵝撲通掉水裏。兩家為此隔著河互罵了小半個月。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103005_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6606,"名稱":"碎片6","說明":"聽說多年以前，有個手腳不乾淨的飛賊被衙役追得走投無路，撲通跳進水裏想借水道逃跑。誰知那水域是王阿婆家大白鵝的領地。那賊還沒游出十米遠，就被十幾只凶神惡煞的大鵝連叨帶擰，哭爹喊娘地自己爬上岸投了案。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103006_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6607,"名稱":"碎片7","說明":"你以為只有京城大街上會堵馬車？咱水鄉的河道逢年過節也是一絕！各家烏篷船、花艇擠在窄河道里首尾相連。賣瓜子的索性不划船了，直接踩著各家的船幫子一路走一路叫賣，生生把水路走成了陸路！","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103007_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6608,"名稱":"碎片8","說明":"沿河住的閒漢們有懶招，躺在二樓木榻上，順著窗戶吊根魚線在水裏掛著。睡上一個甜長的午覺醒來，拽一拽線繩，運氣好能直接釣上只大大魚。這就是普通人的“願者上鉤”。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103008_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6609,"名稱":"碎片9","說明":"水鄉的阿貓阿狗可比外地的精明！大雨天地上水漫金山，我家大黃狗學會了踩著洗衣盆當船去村頭討骨頭。前兩天我還瞧見鄰居的胖狸貓，蹲在個大西瓜皮上划水，那爪子倒騰得像極了它主人在划船。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103009_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6610,"名稱":"碎片10","說明":"鄉里有隻百年老白龜，大夥兒當水神拜。誰知有一年它爬上岸，大家才發現龜甲上掛著三四塊爛漁網。為這事兒，老輩們特意在各處插了警告木牌：“水路千萬條，乾淨第一條。亂丟爛網者，倒黴一整年！”","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103010_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6611,"名稱":"碎片11","說明":"水鄉潮氣重，字畫都得精心養護著。先前橋頭那邊有個算命的瞎子，平時最愛顯擺他那把鎮攤的紙扇。結果陰雨連著下了半月，再出攤時他猛地一抖扇子裝高深，扇面被髮黴的糊子黏死，直接生生撕成了兩半。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103011_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6612,"名稱":"碎片12","說明":"當年有家閨女嫁給了北方來的富商，是個見了水就腿軟的旱鴨子。跟著媳婦出門，一上小烏篷船兩條腿抖成篩糠。他現在出門去個丈母娘家，都得僱兩個水性最好的漢子在船兩邊護駕，腰上還得掛著兩個大空葫蘆，免得踩空沉水。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103012_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6613,"名稱":"碎片13","說明":"外地客總愛自己租個小舟兜風，可水鄉的河道比蜘蛛網還密！上個月有個書生繞了半天都沒轉出同一座橋，最後還是花了些銀兩，請鄉里的小孩站船頭指路才轉出去。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103013_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6614,"名稱":"碎片14","說明":"夏天水鄉人愛借河水冰鎮吃食。臨河人家拿麻繩拴著個竹簍浸在水裏，竹簍裏全是綠豆湯和鮮果。不過常有倒黴蛋沒繫緊繩，眼睜睜看著自家的竹簍，順著水流飄走了。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103014_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6615,"名稱":"碎片15","說明":"當鋪掌櫃收藏了一張千年前的《水域勘圖》。舊圖載明，水鄉當年地勢極低，是座寸土寸金的繁華城池。可惜滄海桑田，地陷引江水倒灌淹沒了一切。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103015_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6616,"名稱":"碎片16","說明":"漁火集市有個商品叫“買全網”。漁民懶得摘纏網的水草，十文錢連網帶泥甩賣。上回有個外地客商當面割開漁網，裡面除了爛樹根，竟真滾出個拳頭大的夜明珠，現在天不亮就有一堆人蹲在集市搶破爛。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103016_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6617,"名稱":"碎片17","說明":"單身漢來燈夢迴廊湊熱鬧簡直是找罪受。放眼望去，迴廊兩邊的全是你儂我儂的情侶。據說有個氣急敗壞的光棍自己放了個大河燈，上頭寫著“棒打鴛鴦”，剛放進水，就被旁邊的小情侶一長篙給狠狠戳沉了。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103017_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6618,"名稱":"碎片18","說明":"別看晚上放燈時漫天浪漫，水鄉的半大孩子們可精著呢。等後半夜情侶們散了，孩子們就划着個破菱桶在下游堵著撈河燈。把乾花紙一扯，糊個新的明晚接著賣，美其名曰“緣分輪迴”。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103018_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6619,"名稱":"碎片19","說明":"據說迴廊欄杆邊每天至少有三個人落水。一半是看花燈看得太入迷踩空的，另一半是打情罵俏時男方想耍帥，沒站穩一頭栽下去的。現在廊橋底下常年守著幾個漁夫，專門撈落水公子，撈一次收一兩銀子，生意比打魚還好。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103019_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":6620,"名稱":"碎片20","說明":"早幾年龍吸潭邊滿是江湖騙子的攤位。賣所謂的“定水珠”“避水符”，還有號稱能釣起潭中祕寶的魚竿。結果有個官員被騙去十兩銀子，一怒之下讓衙役把這幫神棍捆起來全扔水淺處泡了一宿，這才消停。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"十里水鄉/103103020_水鄉舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]}]},"事件數":57,"引用":{"類":"歷練","名":"十里水鄉","名稱":"十里水鄉","編號":203}}