":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105002_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8603,"名稱":"碎片3","說明":"老一輩學子記得的正心書院：土牆、漏雨的學堂、三間教室擠五十個學生，冬天硯台裏的墨會凍住。後來書院出了幾個登科的學生，縣裏撥了銀子修了瓦房；再後來有人做了官，送來了京城的新書和教案。夫子常說，如今書院的每塊青磚，都是學長們考出來的。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105003_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8604,"名稱":"碎片4","說明":"正心書院依山而建，松柏環繞。春日裏常有山雀飛進學堂，落在橫樑上歪頭聽課。有回洪夫子講《詩經》講得入神，一隻松鼠蹲在窗台上聽了整堂課都沒走。學子們打趣說：“連松鼠都聽懂了，你還沒背下來？”此話後來成了書院裏催人背書的萬能句式。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105004_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8605,"名稱":"碎片5","說明":"書院門口有棵老柳樹，不知哪一屆學子開的頭，把寫了心願的布條系在枝上。起初是“盼秋闈高中”，後來什麼都有，“盼食堂換菜”“盼洪夫子少佈置課業”“盼隔壁那個總借我墨的人還我墨”。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105005_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8606,"名稱":"碎片6","說明":"書院早年僱不起廚子，全靠學子爹娘輪流來食堂做飯。張家烙餅李家熬粥，菜色全看各家地裏收了什麼，學子們私下喚作“百家飯”。如今書院條件好了，但每逢鄉試前，食堂仍會按當年老方子，給全院做一頓家鄉味的蔥油餅。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105006_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8607,"名稱":"碎片7","說明":"訪學這幾日，兩方學子湊在一處閒聊，聊著聊著便對起帳來。\\n“你們夫子是不是也說過‘你們是最差的一屆’？”\\n“你們夫子是不是也拖堂？”\\n“你們也傳抄‘學長說必考的重點’，結果一題都沒考？”\\n兩方學子齊齊嘆氣：“原來天下學子一樣苦。”","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105007_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8608,"名稱":"碎片8","說明":"書院嚴禁看雜書，大家的話本都藏得隱祕。但總能被洪夫子精準地從牀板下、磚縫裏搜出。學子們驚歎夫子定有神通。直到某日，有人偷聽到回院探望的師兄正在跟夫子邀功：“我當年藏書的絕妙死角，可是全告訴您了。您去這些地方搜搜，保準有收穫。”","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105008_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8609,"名稱":"碎片9","說明":"書院後山有片野果林。夫子三令五申不許私摘，但晨讀時總有學子嘴角染紅。某日山長巡視，不慎從袖中掉出兩個紅果，全場死寂。山長乾咳一聲，默默撿起：“此果甚酸，老夫替你們試過了，下次莫貪嘴。”","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105009_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8610,"名稱":"碎片10","說明":"書院有隻大黃狗，常在講堂外晃悠。某次背書有學子卡殼，黃狗在窗外正好“汪”了一聲，音調竟與下句奇蹟般契合，學子大為慶幸。如今這狗被尊稱為“黃學長”，每天都有新生恭恭敬敬地給它進貢食堂的肉包子。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105010_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8611,"名稱":"碎片11","說明":"書院地處山野之間，秋晨多濃霧，三步外不辨人影。曾有學子在霧中攬住一人肩膀大吐苦水，痛罵夫子課業繁重。走到堂前霧散，才發現被攬著且頻頻點頭的正是夫子本人。自此，晨霧天大家一律閉嘴趕路，誰也不敢再在霧裏亂認朋友。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105011_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8612,"名稱":"碎片12","說明":"書院後山多獼猴。早年總有學子以“課業被猴搶了”逃避檢查。直到洪夫子親自查探，竟真從猴窩翻出十幾卷寫得極敷衍的策論。自此書院多了條規矩：功課寫完務必立刻收好，防風防盜防山猴。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105012_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8613,"名稱":"碎片13","說明":"夏日無冰，學子們常把採來的野果裝進網兜，沉入後院山泉冰鎮。某次網兜破裂，幾個果子順溪水一路漂到前院山長腳邊。山長撈起嚐了口，直誇甘甜。後來，山泉成了大家的“冰鑒”，連夫子也會偷偷往裏塞西瓜。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105013_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8614,"名稱":"碎片14","說明":"書院環山，迴音極佳。曾有學子在崖邊背書忘詞，崩潰大喊“背不完了！”。群山傳來悠悠迴音：“完啦——完啦——”學子當場破防痛哭。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105014_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8615,"名稱":"碎片15","說明":"書院在山林中，春雨後萬物生長。某新生半夜覺牀板異動，驚恐以為牀下有鬼，輾轉難眠。天亮一看，竟是一棵春筍頂破了宿舍地磚，硬將牀腿頂高了三寸。後來，那顆倒黴的春筍成了全宿舍連吃三天的加餐。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105015_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8616,"名稱":"碎片16","說明":"國子監曾有一學子在課堂上緊張口誤，將“方老師”喊成了“方老鼠”，滿堂鬨笑。後來院長養了只飛鼠，被學生們私下沿用改稱呼，喚作“方老鼠”。夫子們假裝不知道，學生們假裝沒叫過，只有飛鼠本鼠，每次聽到都驕傲地豎起耳朵。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105016_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8617,"名稱":"碎片17","說明":"院長那隻飛鼠認人。平日裏誰喂都不理，唯獨方行簡一伸手它便跳上肩頭。有學子不信邪，拿松子引誘了半個月，飛鼠絲毫不理。後來那學子策論拿了甲等，飛鼠忽然跳到他桌上蹲了一會兒。諸生奔走相告，原來“方老鼠”也喜歡學霸。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105017_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8618,"名稱":"碎片18","說明":"某年有位世家家主親自前往國子監，據說是因孩子月考被評了下等，要找“那個教書的”討個說法。來時帶了三個隨從，架勢十足。一腳踹開值房門，正撞見方行簡擱下茶盞抬眼看他。家主認出這位，當場腿軟改口：“方、方大人，下官是來給您送束脩的！”","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105018_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8619,"名稱":"碎片19","說明":"國子監的夫子們在課上素來板著張臉，罵起人來嗓門能掀屋頂，學子們見之如鼠見貓。某日有學子抄近道經過教師值房，瞧見窗內眾夫子閒聊，笑得眼睛都眯沒了，肩膀一抖一抖的。那學子嚇得連退三步，逢人便說撞了邪見了鬼。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105019_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]},{"編號":8620,"名稱":"碎片20","說明":"沈崇崢講策論時聲如洪鐘，隔著三間教室都能聽見。有一回隔壁柳夫子正講詩賦，“春風又綠江南岸——”隔壁傳來沈夫子的聲音：“破題需謹慎果斷！”引得滿堂大笑。此後每逢兩人同一時辰授課，學子們便私下押注：今日柳夫子的詩句會被沈夫子接成什麼。","探索度":2,"解鎖":[{"文":"完成事件","事件":{"類":"歷練","名":"玉蒼山/103105020_玉蒼舊聞"}}],"獎勵":[{"類":"資源","名":"金錠","量":10}]}]},"事件數":58,"引用":{"類":"歷練","名":"玉蒼山","名稱":"玉蒼山","編號":205}}