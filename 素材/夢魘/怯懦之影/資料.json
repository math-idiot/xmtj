{"名稱":"怯懦之影","分類":"夢魘","圖片編號":20124,"特性":"閃避","稱號":"魘怪","故事":[{"第幾段":1,"標題":"怯懦之影（一）","內文":"好討厭他，怎麼會有這麼討厭的人。\n明明是那樣普通，可大家都那麼誇讚他。\n他是那樣的如魚得水，風生水起。\n他什麼時候能失意一次呢，我就高興了。","解鎖消耗":"怯懦之影·殘頁×25","解鎖消耗碼":"2_21020_25","解鎖獎勵":"金錠×50","解鎖獎勵碼":"13_50","產出":[{"類型":"資源","編號":13,"名稱":"金錠","數量":"50"}],"消耗":[{"類型":"道具","編號":21020,"名稱":"怯懦之影·殘頁","數量":"25"}]},{"第幾段":2,"標題":"怯懦之影（二）","內文":"那夜，我做了個夢。\n夢裏我就是那攤泥水，軟弱、自卑。\n而他就站在不遠處，陽光落在他的身上，亮得刺眼。\n然後把我襯得更暗、更髒、更不堪。\n我開始恨那道光，我開始恨他。\n可他聽不見，他只是站在那裡，做他自己。","解鎖消耗":"怯懦之影·殘頁×25","解鎖消耗碼":"2_21020_25","解鎖獎勵":"邀約帖×1","解鎖獎勵碼":"2_302_1","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"1"}],"消耗":[{"類型":"道具","編號":21020,"名稱":"怯懦之影·殘頁","數量":"25"}]},{"第幾段":3,"標題":"怯懦之影（三）","內文":"我終於受不了那刺眼的陽光了。\n只要看不見他，只要沒有光，我就不會再被比下去了。\n我不再出門，我逃避所要面對的一切。\n慢慢地，一點點地，和屋裏的黑暗徹底長在了一起。","解鎖消耗":"怯懦之影·殘頁×30","解鎖消耗碼":"2_21020_30","解鎖獎勵":"SSR屬性碎片自選×10","解鎖獎勵碼":"2_910_10","產出":[{"類型":"道具","編號":910,"名稱":"SSR屬性碎片自選","數量":"10"}],"消耗":[{"類型":"道具","編號":21020,"名稱":"怯懦之影·殘頁","數量":"30"}]}],"最低級數值":{"等級":4,"屬性":[{"名稱":"氣勢","編號":3,"數值":"528"},{"名稱":"攻擊","編號":1,"數值":"150"},{"名稱":"防禦","編號":2,"數值":"12"},{"名稱":"暴擊率","編號":15,"數值":"450"},{"名稱":"團隊閃避率","編號":16,"數值":"140"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"270"},{"名稱":"團隊抗暴率","編號":18,"數值":"150"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"150"},{"名稱":"團隊效果閃避","編號":42,"數值":"150"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["墨妖","怯懦之影"],"夢魘錄":["怯懦之影"],"歷練掛機":["怯懦之影"],"鎮魘塔":["怯懦之影"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"怯懦之影","分類":"夢魘","子類":null,"鍵":"怯懦之影","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png"}}