{"名稱":"黯淡靈團","分類":"夢魘","圖片編號":20117,"特性":"治療","稱號":"魘怪","故事":[{"第幾段":1,"標題":"黯淡靈團（一）","內文":"小小人兒小小愁，小小愁兒掛眉頭。\n晨起尋履履無蹤，午來追蝶蝶不留，黃犬偷我桂花糕，青蟻銜我蜜漬藕。\n小小人兒小小愁，小小愁兒掛心頭。\n阿娘喚我讀書卷，夫子罰我站牆角，春風吹跑紙鳶線，秋雨打溼新衣衫。","解鎖消耗":"黯淡靈團·殘頁×25","解鎖消耗碼":"2_21017_25","解鎖獎勵":"金錠×50","解鎖獎勵碼":"13_50","產出":[{"類型":"資源","編號":13,"名稱":"金錠","數量":"50"}],"消耗":[{"類型":"道具","編號":21017,"名稱":"黯淡靈團·殘頁","數量":"25"}]},{"第幾段":2,"標題":"黯淡靈團（二）","內文":"數一數，十指愁，一愁未了一愁稠。\n小小人兒嘆口氣，忽聽巷口撥浪起。\n賣糖翁翁過橋頭，噔噔噔噔下小樓。\n一顆糖，含口中，甜從舌尖到心頭。","解鎖消耗":"黯淡靈團·殘頁×40","解鎖消耗碼":"2_21017_40","解鎖獎勵":"邀約帖×1","解鎖獎勵碼":"2_302_1","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"1"}],"消耗":[{"類型":"道具","編號":21017,"名稱":"黯淡靈團·殘頁","數量":"40"}]},{"第幾段":3,"標題":"黯淡靈團（三）","內文":"小小人兒小小愁，今日煩惱到此收。\n明朝又有新愁到，明朝再皺小眉頭。\n看那窗外月如鉤，且把紙鳶做，夢裏還去抓泥鰍！","解鎖消耗":"黯淡靈團·殘頁×70","解鎖消耗碼":"2_21017_70","解鎖獎勵":"SSR屬性碎片自選×10","解鎖獎勵碼":"2_910_10","產出":[{"類型":"道具","編號":910,"名稱":"SSR屬性碎片自選","數量":"10"}],"消耗":[{"類型":"道具","編號":21017,"名稱":"黯淡靈團·殘頁","數量":"70"}]}],"最低級數值":{"等級":10,"屬性":[{"名稱":"氣勢","編號":3,"數值":"1181"},{"名稱":"攻擊","編號":1,"數值":"401"},{"名稱":"防禦","編號":2,"數值":"22"},{"名稱":"暴擊率","編號":15,"數值":"270"},{"名稱":"團隊閃避率","編號":16,"數值":"50"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"450"},{"名稱":"團隊抗暴率","編號":18,"數值":"50"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"50"},{"名稱":"團隊效果閃避","編號":42,"數值":"50"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["角落的執念","黯淡靈團"],"夢魘錄":["黯淡靈團"],"歷練掛機":["黯淡靈團"],"鎮魘塔":["黯淡靈團"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"黯淡靈團","分類":"夢魘","子類":null,"鍵":"黯淡靈團","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png","說明":"這一區是「被別人引用時怎麼畫我」。圖的完整路徑 = 素材/<素材路徑>/<縮圖 或 圖>。沒有連結代表這一類還沒有自己的範本。"}}