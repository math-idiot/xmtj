{"名稱":"窺伺之蛇","分類":"夢魘","圖片編號":20108,"特性":"治療","稱號":"魘怪","故事":[{"第幾段":1,"標題":"窺伺之蛇（一）","內文":"曾經的我們只有彼此。\n她是我心中唯一重要之人，我將她的所求，視為我的所求。\n可我失去了她。\n我憎恨這個骯髒的人世，將她從我身邊奪走。\n可我又不得不活在人世，因為她還會回來。","解鎖消耗":"窺伺之蛇·殘頁×20","解鎖消耗碼":"2_21008_20","解鎖獎勵":"日晷×1800","解鎖獎勵碼":"110_1800","產出":[{"類型":"資源","編號":110,"名稱":"日晷","數量":"1800"}],"消耗":[{"類型":"道具","編號":21008,"名稱":"窺伺之蛇·殘頁","數量":"20"}]},{"第幾段":2,"標題":"窺伺之蛇（二）","內文":"為什麼？為什麼你要對別人笑？\n為什麼？為什麼我們不再是彼此的唯一？\n為什麼？為什麼？為什麼？\n她是我的，我是她的，我們就該永遠地擁有彼此佔有彼此，不是嗎？","解鎖消耗":"窺伺之蛇·殘頁×30","解鎖消耗碼":"2_21008_30","解鎖獎勵":"邀約帖×2","解鎖獎勵碼":"2_302_2","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"2"}],"消耗":[{"類型":"道具","編號":21008,"名稱":"窺伺之蛇·殘頁","數量":"30"}]},{"第幾段":3,"標題":"窺伺之蛇（三）","內文":"她希望我成為一個平和的、善良的人。\n可她不知道，我是那麼的自私、卑鄙、無恥。\n如果是為了她，我可以裝成她心目中的樣子，然後我要永遠地站在她身邊。\n窺伺她的人生，滿足我與她永不分離的慾望。","解鎖消耗":"窺伺之蛇·殘頁×20","解鎖消耗碼":"2_21008_20","解鎖獎勵":"SSR萬能卡×10","解鎖獎勵碼":"2_1001_10","產出":[{"類型":"道具","編號":1001,"名稱":"SSR萬能卡","數量":"10"}],"消耗":[{"類型":"道具","編號":21008,"名稱":"窺伺之蛇·殘頁","數量":"20"}]}],"最低級數值":{"等級":6,"屬性":[{"名稱":"氣勢","編號":3,"數值":"972"},{"名稱":"攻擊","編號":1,"數值":"330"},{"名稱":"防禦","編號":2,"數值":"18"},{"名稱":"暴擊率","編號":15,"數值":"450"},{"名稱":"團隊閃避率","編號":16,"數值":"90"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"270"},{"名稱":"團隊抗暴率","編號":18,"數值":"100"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"100"},{"名稱":"團隊效果閃避","編號":42,"數值":"100"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["窺伺之蛇","窺伺的魘怪"],"夢魘錄":["窺伺之蛇"],"歷練掛機":["窺伺之蛇"],"鎮魘塔":["窺伺之蛇"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"窺伺之蛇","分類":"夢魘","子類":null,"鍵":"窺伺之蛇","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png","說明":"這一區是「被別人引用時怎麼畫我」。圖的完整路徑 = 素材/<素材路徑>/<縮圖 或 圖>。沒有連結代表這一類還沒有自己的範本。"}}