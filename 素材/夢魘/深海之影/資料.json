{"名稱":"深海之影","分類":"夢魘","圖片編號":20115,"特性":"暴擊","稱號":"魘怪","故事":[{"第幾段":1,"標題":"深海之影（一）","內文":"海里來了一群人。他們在海底佈下機關，毀了成片的珊瑚，只為了尋找一樣傳說中的珍寶。\n水底的泥沙被攪得渾濁不堪，往日澄澈的家園變成了佈滿陷阱的獵場。\n我看不見媽媽了，看不見昨天一起玩耍的夥伴了，看不見上面的光了。\n他們什麼時候滾出去？滾出去，滾出去……","解鎖消耗":"深海之影·殘頁×50","解鎖消耗碼":"2_21015_50","解鎖獎勵":"日晷×1800","解鎖獎勵碼":"110_1800","產出":[{"類型":"資源","編號":110,"名稱":"日晷","數量":"1800"}],"消耗":[{"類型":"道具","編號":21015,"名稱":"深海之影·殘頁","數量":"50"}]},{"第幾段":2,"標題":"深海之影（二）","內文":"掠奪者來了一批，又一批。\n他們沒有找到那樣珍寶，可他們不肯走。\n他們說：“一定就在這片海里。”\n他們說：“我們花了這麼多力氣，怎麼能空手回去？”\n我們的恐懼一點點聚集起來，一團團纏繞起來，變成了一個龐大的、說不清形狀的東西。\n滾出去，滾出去，滾出去……","解鎖消耗":"深海之影·殘頁×60","解鎖消耗碼":"2_21015_60","解鎖獎勵":"邀約帖×2","解鎖獎勵碼":"2_302_2","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"2"}],"消耗":[{"類型":"道具","編號":21015,"名稱":"深海之影·殘頁","數量":"60"}]},{"第幾段":3,"標題":"深海之影（三）","內文":"岸上的人開始說，這片海有妖怪。\n路過的船隻迷失在這片海域的迷霧裏，船上的旅人恐懼著迷霧中突然躍起的龐然大物。\n它什麼也聽不到。\n它什麼也不會分辨。\n它只知道——\n人來了。","解鎖消耗":"深海之影·殘頁×110","解鎖消耗碼":"2_21015_110","解鎖獎勵":"SSR萬能卡×10","解鎖獎勵碼":"2_1001_10","產出":[{"類型":"道具","編號":1001,"名稱":"SSR萬能卡","數量":"10"}],"消耗":[{"類型":"道具","編號":21015,"名稱":"深海之影·殘頁","數量":"110"}]}],"最低級數值":{"等級":42,"屬性":[{"名稱":"執念屏障","編號":200,"數值":"120"},{"名稱":"氣勢","編號":3,"數值":"40565"},{"名稱":"攻擊","編號":1,"數值":"9219"},{"名稱":"防禦","編號":2,"數值":"751"},{"名稱":"暴擊率","編號":15,"數值":"1690"},{"名稱":"團隊閃避率","編號":16,"數值":"170"},{"名稱":"擊破率","編號":204,"數值":"1010"},{"名稱":"效果命中","編號":41,"數值":"1010"},{"名稱":"團隊抗暴率","編號":18,"數值":"200"},{"名稱":"命中率","編號":17,"數值":"1170"},{"名稱":"團隊抗擊破","編號":214,"數值":"200"},{"名稱":"團隊效果閃避","編號":42,"數值":"200"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["深海之影","深潭之影"],"夢魘錄":["深海之影"],"鎮魘塔":["深海之影"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"深海之影","分類":"夢魘","子類":null,"鍵":"深海之影","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png"}}