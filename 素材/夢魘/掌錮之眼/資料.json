{"名稱":"掌錮之眼","分類":"夢魘","圖片編號":20105,"特性":"閃避","稱號":"魘怪","故事":[{"第幾段":1,"標題":"掌錮之眼（一）","內文":"舊廟裏，供著一尊神像。\n傳說神像的掌心都刻著眼，能看盡人的前程禍福。\n昔年香火日盛，求問前程的絡繹不絕。\n求官的怕落第，求姻緣的怕錯付，求子嗣的怕斷絕，求長壽的怕病榻……\n人人都想搶先一步看清明日，以為看清了便能避開痛苦。","解鎖消耗":"掌錮之眼·殘頁×30","解鎖消耗碼":"2_21005_30","解鎖獎勵":"日晷×1800","解鎖獎勵碼":"110_1800","產出":[{"類型":"資源","編號":110,"名稱":"日晷","數量":"1800"}],"消耗":[{"類型":"道具","編號":21005,"名稱":"掌錮之眼·殘頁","數量":"30"}]},{"第幾段":2,"標題":"掌錮之眼（二）","內文":"有一位年輕的官員入廟求問前程。\n所謂的神使解讀神意，他便誤以為自己將被身邊親近之人所害。\n他開始疏遠、提防、算計，最終身邊親近之人成為了他的仇敵，他最害怕的結局，也因此到來。","解鎖消耗":"掌錮之眼·殘頁×30","解鎖消耗碼":"2_21005_30","解鎖獎勵":"邀約帖×2","解鎖獎勵碼":"2_302_2","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"2"}],"消耗":[{"類型":"道具","編號":21005,"名稱":"掌錮之眼·殘頁","數量":"30"}]},{"第幾段":3,"標題":"掌錮之眼（三）","內文":"死前，他在牢中做了一個夢，夢中他被命運所化成的手掌禁錮，看不清前路。\n直到有聲音點醒了他，讓他在最後的時刻頓悟。\n他不該為了躲開還未發生的事，親手做下此刻便會後悔的事。","解鎖消耗":"掌錮之眼·殘頁×40","解鎖消耗碼":"2_21005_40","解鎖獎勵":"SSR萬能卡×10","解鎖獎勵碼":"2_1001_10","產出":[{"類型":"道具","編號":1001,"名稱":"SSR萬能卡","數量":"10"}],"消耗":[{"類型":"道具","編號":21005,"名稱":"掌錮之眼·殘頁","數量":"40"}]}],"最低級數值":{"等級":3,"屬性":[{"名稱":"氣勢","編號":3,"數值":"0"},{"名稱":"攻擊","編號":1,"數值":"0"},{"名稱":"防禦","編號":2,"數值":"0"},{"名稱":"暴擊率","編號":15,"數值":"450"},{"名稱":"團隊閃避率","編號":16,"數值":"140"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"270"},{"名稱":"團隊抗暴率","編號":18,"數值":"150"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"150"},{"名稱":"團隊效果閃避","編號":42,"數值":"150"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["掌錮之眼"],"夢魘錄":["掌錮之眼"],"歷練掛機":["掌錮之眼"],"鎮魘塔":["掌錮之眼"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"掌錮之眼","分類":"夢魘","子類":null,"鍵":"掌錮之眼","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png","說明":"這一區是「被別人引用時怎麼畫我」。圖的完整路徑 = 素材/<素材路徑>/<縮圖 或 圖>。沒有連結代表這一類還沒有自己的範本。"}}