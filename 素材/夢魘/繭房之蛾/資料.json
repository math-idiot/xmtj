{"名稱":"繭房之蛾","分類":"夢魘","圖片編號":20113,"特性":"增傷","稱號":"魘怪","故事":[{"第幾段":1,"標題":"繭房之蛾（一）","內文":"有的人仗著身份，自覺自己高人一等，什麼都對。\n而身邊圍繞的也全是一群阿諛奉承之人。\n他說，此等文章感覺不對。便有人附和，大人所言極是！\n他說，你們都應該向我學習，去看看那本書。便有人附和，大人所言極是！\n他今天說東，明天說西。依然有人附和，大人所言極是！","解鎖消耗":"繭房之蛾·殘頁×30","解鎖消耗碼":"2_21013_30","解鎖獎勵":"金錠×50","解鎖獎勵碼":"13_50","產出":[{"類型":"資源","編號":13,"名稱":"金錠","數量":"50"}],"消耗":[{"類型":"道具","編號":21013,"名稱":"繭房之蛾·殘頁","數量":"30"}]},{"第幾段":2,"標題":"繭房之蛾（二）","內文":"周遭的應和，讓他滿足。\n慢慢的，只聽得見贊同自己的聲音。\n慢慢的，把“我以為”當成“天下皆然”。\n人心似繭，再聽不見外面的聲音。","解鎖消耗":"繭房之蛾·殘頁×20","解鎖消耗碼":"2_21013_20","解鎖獎勵":"邀約帖×1","解鎖獎勵碼":"2_302_1","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"1"}],"消耗":[{"類型":"道具","編號":21013,"名稱":"繭房之蛾·殘頁","數量":"20"}]},{"第幾段":3,"標題":"繭房之蛾（三）","內文":"那一年，他從高處跌落，身邊那些贊同的聲音瞬間消散。 \n大牢裏風穿過鐵窗，嗚嗚地響。\n他對著空蕩蕩的牢房，一遍又一遍地說：\n“我說得對，對不對？”\n“……所言極是，對不對？”\n“你們倒是說呀！”\n“怎麼沒人說話了呀……”","解鎖消耗":"繭房之蛾·殘頁×15","解鎖消耗碼":"2_21013_15","解鎖獎勵":"SSR屬性碎片自選×10","解鎖獎勵碼":"2_910_10","產出":[{"類型":"道具","編號":910,"名稱":"SSR屬性碎片自選","數量":"10"}],"消耗":[{"類型":"道具","編號":21013,"名稱":"繭房之蛾·殘頁","數量":"15"}]}],"最低級數值":{"等級":4,"屬性":[{"名稱":"氣勢","編號":3,"數值":"720"},{"名稱":"攻擊","編號":1,"數值":"250"},{"名稱":"防禦","編號":2,"數值":"17"},{"名稱":"暴擊率","編號":15,"數值":"450"},{"名稱":"團隊閃避率","編號":16,"數值":"140"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"270"},{"名稱":"團隊抗暴率","編號":18,"數值":"150"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"150"},{"名稱":"團隊效果閃避","編號":42,"數值":"150"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["編織之蛾","繭房之蛾"],"夢魘錄":["繭房之蛾"],"歷練掛機":["繭房之蛾"],"鎮魘塔":["繭房之蛾"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"繭房之蛾","分類":"夢魘","子類":null,"鍵":"繭房之蛾","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png","說明":"這一區是「被別人引用時怎麼畫我」。圖的完整路徑 = 素材/<素材路徑>/<縮圖 或 圖>。沒有連結代表這一類還沒有自己的範本。"}}