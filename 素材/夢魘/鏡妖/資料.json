{"名稱":"鏡妖","分類":"夢魘","圖片編號":20106,"特性":"降暴","稱號":"魘怪","故事":[{"第幾段":1,"標題":"鏡妖（一）","內文":"昔年宮殿深處，有一面落了灰的舊鏡。\n新入宮的人，左臉有一道淺淺的疤。她不知是不是因此才久久不得寵愛。\n“你想變得更美嗎？”\n那一夜，她又一次獨自撫鏡垂淚，恍惚聽見鏡中傳來一個聲音。\n她怔住，鏡中的自己，正笑著望她。","解鎖消耗":"鏡妖·殘頁×20","解鎖消耗碼":"2_21006_20","解鎖獎勵":"日晷×1800","解鎖獎勵碼":"110_1800","產出":[{"類型":"資源","編號":110,"名稱":"日晷","數量":"1800"}],"消耗":[{"類型":"道具","編號":21006,"名稱":"鏡妖·殘頁","數量":"20"}]},{"第幾段":2,"標題":"鏡妖（二）","內文":"後來她得寵了。\n姐妹們看她的眼神變了，下人們也都更恭敬了。\n原來這就是美麗的滋味。\n原來這就是被人憐愛的滋味。\n\n“再美一點。”她對鏡中人說，“再美一點，就好了。”\n鏡中人也笑：“可以。只是你要拿什麼來換？”","解鎖消耗":"鏡妖·殘頁×20","解鎖消耗碼":"2_21006_20","解鎖獎勵":"邀約帖×2","解鎖獎勵碼":"2_302_2","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"2"}],"消耗":[{"類型":"道具","編號":21006,"名稱":"鏡妖·殘頁","數量":"20"}]},{"第幾段":3,"標題":"鏡妖（三）","內文":"可美麗，是一個填不滿的洞。鏡中人的要求也越來越多。上供、奪命、棄子……她事事做絕，到最後眾叛親離。\n美麗並沒能為她帶來一切。\n賜死的毒藥被灌下時，她躺在牀上，只反反覆覆念一句：“鏡子……把鏡子拿來……”\n後來，那座宮殿漸漸被人遺忘。\n偶爾有夜深路過的小宮女，說能聽見鏡子裏有個聲音：“你想變得更年輕、更尊貴、更受人憐愛嗎？”","解鎖消耗":"鏡妖·殘頁×20","解鎖消耗碼":"2_21006_20","解鎖獎勵":"SSR萬能卡×10","解鎖獎勵碼":"2_1001_10","產出":[{"類型":"道具","編號":1001,"名稱":"SSR萬能卡","數量":"10"}],"消耗":[{"類型":"道具","編號":21006,"名稱":"鏡妖·殘頁","數量":"20"}]}],"最低級數值":{"等級":12,"屬性":[{"名稱":"執念屏障","編號":200,"數值":"120"},{"名稱":"氣勢","編號":3,"數值":"2475"},{"名稱":"攻擊","編號":1,"數值":"688"},{"名稱":"防禦","編號":2,"數值":"46"},{"名稱":"暴擊率","編號":15,"數值":"270"},{"名稱":"團隊閃避率","編號":16,"數值":"50"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"450"},{"名稱":"團隊抗暴率","編號":18,"數值":"50"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"50"},{"名稱":"團隊效果閃避","編號":42,"數值":"50"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["畫皮之靈","空權座","鏡妖","鏡妖-火"],"夢魘錄":["鏡妖"],"血月危機":["畫皮之靈"],"鎮魘塔":["鏡妖"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"鏡妖","分類":"夢魘","子類":null,"鍵":"鏡妖","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png"