{"名稱":"求愛小丑","分類":"夢魘","圖片編號":20102,"特性":"傷害","稱號":"魘怪","故事":[{"第幾段":1,"標題":"求愛小丑（一）","內文":"民間有個傳言。\n姻緣遲遲未定的女子，可在月下取一截紅線，繫於花枝，祈一段良緣。\n凝香便是如此，在月下繫了很多條紅線。\n她想著如此，那位高升的心上人便會回心轉意來娶她。","解鎖消耗":"求愛小丑·殘頁×35","解鎖消耗碼":"2_21002_35","解鎖獎勵":"金錠×50","解鎖獎勵碼":"13_50","產出":[{"類型":"資源","編號":13,"名稱":"金錠","數量":"50"}],"消耗":[{"類型":"道具","編號":21002,"名稱":"求愛小丑·殘頁","數量":"35"}]},{"第幾段":2,"標題":"求愛小丑（二）","內文":"出宮的姐妹帶回了消息，他的心上人已娶了富貴人家的小姐，不會再回頭了。\n凝香怎麼也想不通，自己是哪裡做錯了，自己是哪裡做得不好了。\n那一夜，喜堂的紅燭她自己點了，蓋頭她自己蓋了，三拜的話她自己唸了。\n天亮時，織造司的姐妹們說凝香失蹤了。","解鎖消耗":"求愛小丑·殘頁×20","解鎖消耗碼":"2_21002_20","解鎖獎勵":"邀約帖×1","解鎖獎勵碼":"2_302_1","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"1"}],"消耗":[{"類型":"道具","編號":21002,"名稱":"求愛小丑·殘頁","數量":"20"}]},{"第幾段":3,"標題":"求愛小丑（三）","內文":"禁軍在御花園的一處角落找到了她，她面帶笑容，逢人便要遞上繡球，道一聲：“收下吧，看我一眼吧，只要你點頭，我們便是天定良緣。”\n心醫執燈入夢，見著了那求愛之心所化的魘怪。\n“不是你不夠好，是他不配與你同行。”\n“好好珍愛自己，才能遇見生命中更多的美好。\"","解鎖消耗":"求愛小丑·殘頁×15","解鎖消耗碼":"2_21002_15","解鎖獎勵":"SSR屬性碎片自選×10","解鎖獎勵碼":"2_910_10","產出":[{"類型":"道具","編號":910,"名稱":"SSR屬性碎片自選","數量":"10"}],"消耗":[{"類型":"道具","編號":21002,"名稱":"求愛小丑·殘頁","數量":"15"}]}],"最低級數值":{"等級":7,"屬性":[{"名稱":"氣勢","編號":3,"數值":"0"},{"名稱":"攻擊","編號":1,"數值":"0"},{"名稱":"防禦","編號":2,"數值":"0"},{"名稱":"暴擊率","編號":15,"數值":"270"},{"名稱":"團隊閃避率","編號":16,"數值":"90"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"450"},{"名稱":"團隊抗暴率","編號":18,"數值":"100"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"100"},{"名稱":"團隊效果閃避","編號":42,"數值":"100"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["求愛小丑"],"夢魘錄":["求愛小丑"],"歷練掛機":["求愛小丑","求愛小丑-土"],"鎮魘塔":["求愛小丑"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"求愛小丑","分類":"夢魘","子類":null,"鍵":"求愛小丑","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png"}}