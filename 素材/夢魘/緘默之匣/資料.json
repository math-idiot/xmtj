{"名稱":"緘默之匣","分類":"夢魘","圖片編號":20104,"特性":"擊暈","稱號":"魘怪","故事":[{"第幾段":1,"標題":"緘默之匣（一）","內文":"九娘被處刑的那日，村裏的人都去了。\n大火蔓延，很快將刑架上的人吞沒。\n圍觀的村民指指點點，說的盡是女子沒有恪守本分的下場。\n“瞧瞧，讀那麼多書有什麼用？”\n“一個女人家，拋頭露面，不知羞恥。”\n“早就該燒了，省得帶壞了村裏的姑娘。”","解鎖消耗":"緘默之匣·殘頁×30","解鎖消耗碼":"2_21004_30","解鎖獎勵":"日晷×1800","解鎖獎勵碼":"110_1800","產出":[{"類型":"資源","編號":110,"名稱":"日晷","數量":"1800"}],"消耗":[{"類型":"道具","編號":21004,"名稱":"緘默之匣·殘頁","數量":"30"}]},{"第幾段":2,"標題":"緘默之匣（二）","內文":"九娘透過火光，將那些嘴臉看盡。她想說什麼，可她知道說什麼都沒有用。\n教她認字的趙秀才知道，她根本沒有勾引他。\n賣豆腐的王嬸知道，那些流言是誰故意傳的。\n抱過她長大的李大娘知道，真正不乾淨的事，是誰做的。\n可沒有一個人開口。\n所以，她開口有什麼用。","解鎖消耗":"緘默之匣·殘頁×50","解鎖消耗碼":"2_21004_50","解鎖獎勵":"邀約帖×2","解鎖獎勵碼":"2_302_2","產出":[{"類型":"道具","編號":302,"名稱":"邀約帖","數量":"2"}],"消耗":[{"類型":"道具","編號":21004,"名稱":"緘默之匣·殘頁","數量":"50"}]},{"第幾段":3,"標題":"緘默之匣（三）","內文":"九娘死後，村裏開始不太平。\n六月飛雪，出村子的路被大雪封住。\n村民們聚集在祠堂裏想要商討對策，可他們瞪著眼睛，互相看著，喉嚨裏發出“嗬嗬”的聲音，再也說不出一句話。","解鎖消耗":"緘默之匣·殘頁×90","解鎖消耗碼":"2_21004_90","解鎖獎勵":"SSR萬能卡×10","解鎖獎勵碼":"2_1001_10","產出":[{"類型":"道具","編號":1001,"名稱":"SSR萬能卡","數量":"10"}],"消耗":[{"類型":"道具","編號":21004,"名稱":"緘默之匣·殘頁","數量":"90"}]}],"最低級數值":{"等級":6,"屬性":[{"名稱":"氣勢","編號":3,"數值":"972"},{"名稱":"攻擊","編號":1,"數值":"330"},{"名稱":"防禦","編號":2,"數值":"18"},{"名稱":"暴擊率","編號":15,"數值":"450"},{"名稱":"團隊閃避率","編號":16,"數值":"90"},{"名稱":"擊破率","編號":204,"數值":"270"},{"名稱":"效果命中","編號":41,"數值":"270"},{"名稱":"團隊抗暴率","編號":18,"數值":"100"},{"名稱":"命中率","編號":17,"數值":"300"},{"名稱":"團隊抗擊破","編號":214,"數值":"100"},{"名稱":"團隊效果閃避","編號":42,"數值":"100"},{"名稱":"無視戰鬥抗性","編號":216,"數值":"0"},{"名稱":"無視戰鬥屬性","編號":215,"數值":"0"}]},"各系統怎麼叫它":{"一般怪物":["緘默之匣","緘默之盒"],"夢魘錄":["緘默之匣"],"歷練掛機":["緘默之匣"],"鎮魘塔":["緘默之匣"]},"圖片":"完整素體.png","未解鎖圖":"未解鎖剪影.png","完整素體":"完整素體.png","全部動作":[{"狀態":"攻擊","動作代號":"attack"},{"狀態":"受擊","動作代號":"hit"},{"狀態":"待機","動作代號":"idle"}],"各版本的圖":{"完整素體":"完整素體.png","立繪":"立繪.png","大圖":"大圖.png","頭像":"頭像.png","技能條頭像":"技能條頭像.png","未解鎖剪影":"未解鎖剪影.png"},"引用":{"名稱":"緘默之匣","分類":"夢魘","子類":null,"鍵":"緘默之匣","編號":null,"品質":null,"等級":null,"圖":"立繪.png","縮圖":"立繪_縮圖.png"}}